{
  "name": "@choppu/shelljs",
  "version": "1.0.1",
  "description": "Keycard Shell Communication Layer",
  "main": "lib/index.js",
  "module": "lib-es/index.js",
  "browser": "lib-es/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "lib-es",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "browser": "./lib-es/index.js",
      "import": "./lib-es/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "url": "https://github.com/choppu/shelljs.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "clean": "rm -rf lib lib-es",
    "pretest": "npm run build:cjs",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "publish": "npm run clean && npm run build && npm publish --access=public"
  },
  "author": "Ksenia Lebedeva",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ethersproject/rlp": "^5.8.0"
  }
}
