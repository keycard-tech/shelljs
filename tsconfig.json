{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": false,
    "outDir": "lib",
    "lib": ["ES2022", "dom"],
    "sourceMap": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "pretty": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "strict": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
